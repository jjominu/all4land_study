<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="board">
	<resultMap type="BoardVO" id="boardVO"> 
		<result column="board_id" property="boardId" />
		<result column="title" property="title" />
		<result column="view" property="view" />
		<result column="content" property="content" />
		<result column="create_timestamp" property="createTimestamp"/>
		<result column="img_name" property="imgName"/>
	</resultMap>


    
	<select id="getList" parameterType="CriteriaVO" resultType="BoardVO"> <!-- 모든 게시글 가져오기-->
		 SELECT
            *
        FROM
            tb_board
        ORDER BY create_timestamp desc
        LIMIT #{perPageNum} OFFSET #{pageStart}
	</select>
	
	<select id="getDetail" resultType="BoardVO" parameterType="int"> <!-- 글 상세정보 들어가기 -->
		SELECT * FROM tb_board where board_Id = #{boardId} 
		
	</select>
	<select id="insertBoard" resultType="int" parameterType="BoardVO" ><!-- 게시글 작성하기-->
		insert into tb_board( title,content) values(#{title},#{content}) RETURNING board_id;
	</select>
	
	
    <delete id="deleteBoard" parameterType="int"> <!-- 게시글 삭제하기 -->
    	delete from tb_board where  board_id =#{boardId};
    </delete>
    
    <update id="increaseView" parameterType="int" > <!-- 상세정보 조회할 때 조회수 증가 -->
    	update tb_board set view = view +1 where  board_id = ${boardId};
    </update>
    
    <update id="updateBoard" parameterType="BoardVO">
    	update tb_board set title=#{title}, content=#{content} where board_id = #{boardId}
    </update>
    
    <select id="searchBoard" parameterType="BoardSearchRequestVO" resultType="BoardVO">
    <if test="searchType=='title'">
     SELECT
            *
        FROM
            tb_board
        WHERE title LIKE CONCAT('%',#{keyword},'%')
        ORDER BY create_timestamp desc
        LIMIT #{perPageNum} OFFSET #{pageStart}
        </if>
        <if test="searchType=='content'">
	    	SELECT
            *
        FROM
            tb_board
        WHERE content LIKE CONCAT('%',#{keyword},'%')
        ORDER BY create_timestamp desc
        LIMIT #{perPageNum} OFFSET #{pageStart}
	    </if> --> 	
   <!-- <if test="searchType=='title'">
	    	select * from tb_board where title LIKE CONCAT('%',#{keyword},'%') ORDER BY create_timestamp DESC; 
	    </if>
	     <if test="searchType=='content'">
	    	select * from tb_board where content LIKE CONCAT('%',#{keyword},'%') ORDER BY create_timestamp DESC; 
	    </if> --> 	
    </select>
    <select id="totalBoardCnt" resultType="int">

    	  select count(*) from tb_board 
    	
    </select>
    
     <select id="totalBoardCntbySearch" parameterType="BoardSearchRequestVO" resultType="int">

    	   select count(*) from tb_board WHERE title LIKE CONCAT('%',#{keyword},'%')
    	
    </select>
    <insert id="uploadFile" parameterType="fileVO">
    	insert into tb_file( board_id,origin_file_name,save_file_name,file_type) values(#{boardId},#{originFileName},#{saveFileName},#{fileType}) 
    </insert>
    
     <select id="getFiles" resultType="FileVO" parameterType="int">
    		SELECT f.* FROM tb_board t join tb_file f on t.board_id = f.board_id where t.board_Id = #{boardId} 
    
    </select>
   
   <delete id="deleteFile" parameterType="int">
   			delete from tb_file where file_id = ${file_id}
   </delete>
</mapper>