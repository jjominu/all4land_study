<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="board">
	<resultMap type="BoardVO" id="boardVO"> 
		<result column="id" property="id" />
		<result column="title" property="title" />
		<result column="view" property="view" />
		<result column="content" property="content" />
		
	</resultMap>
    
	<select id="getList" resultType="BoardVO"> <!-- 모든 게시글 가져오기-->
		SELECT * FROM tb_board ;
	</select>
	
	<select id="getDetail" resultType="BoardVO" parameterType="int"> <!-- 글 상세정보 들어가기 -->
		SELECT * FROM tb_board where id = #{id} 
		
	</select>
	<insert id="insertBoard" parameterType="BoardVO"><!-- 게시글 작성하기-->
		insert into tb_board(id,title,content) values(#{id},#{title},#{content})
	</insert>
	
	
    <delete id="deleteBoard" parameterType="int"> <!-- 게시글 삭제하기 -->
    delete from tb_board
	where id =#{id};
    </delete>
    
    <update id="increaseView" parameterType="int" > <!-- 상세정보 조회할 때 조회수 증가 -->
    		update tb_board set view = view +1 where id = ${id};
    
    </update>
</mapper>